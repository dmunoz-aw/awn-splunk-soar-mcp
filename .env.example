# Splunk SOAR base URL (defaults to the AWN Managed Cloud instance if unset)
SOAR_URL=https://awnsoar.soar.splunkcloud.com

# Plain SOAR API token (ph-auth-token header), NOT a JWT. Generate one from
# SOAR admin -> Users -> (your user) -> API Token. Do not commit this file
# with a real value; set it in your shell env or a local, gitignored .env.
SOAR_MCP_TOKEN=

# Optional overrides
# SOAR_VERIFY_SSL=true
# SOAR_TIMEOUT=30
